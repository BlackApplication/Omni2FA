{
  "name": "@omni2fa/react",
  "version": "0.0.0",
  "description": "Omni2FA — headless React adapter. Thin hooks (useLoginFlow, useEnrollTotp, …) that subscribe to @omni2fa/core stores via useSyncExternalStore. No business logic — bring your own UI, or use @omni2fa/react-mui for a styled drop-in.",
  "keywords": [
    "2fa",
    "mfa",
    "totp",
    "webauthn",
    "react",
    "headless",
    "hooks"
  ],
  "author": "BlackApplication",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackApplication/Omni2FA.git",
    "directory": "React/react"
  },
  "bugs": {
    "url": "https://github.com/BlackApplication/Omni2FA/issues"
  },
  "homepage": "https://github.com/BlackApplication/Omni2FA#readme",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@omni2fa/core": "0.0.0"
  }
}

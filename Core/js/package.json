{
  "name": "@omni2fa/core",
  "version": "0.0.0",
  "description": "Omni2FA — framework-agnostic TypeScript core. State machines, WebAuthn ceremony, HTTP client, timers, validation. No React/Vue/Angular dependencies. Consumed by @omni2fa/react and future Vue/Angular/Svelte adapters.",
  "keywords": [
    "2fa",
    "two-factor-authentication",
    "mfa",
    "totp",
    "webauthn",
    "passkey",
    "email-otp",
    "framework-agnostic",
    "headless"
  ],
  "author": "BlackApplication",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackApplication/Omni2FA.git",
    "directory": "Core/js"
  },
  "bugs": {
    "url": "https://github.com/BlackApplication/Omni2FA/issues"
  },
  "homepage": "https://github.com/BlackApplication/Omni2FA#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "types:generate": "openapi-typescript ../protocol/omni2fa.openapi.yaml -o src/types/api.ts",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4",
    "xstate": "^5.19.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0"
  }
}

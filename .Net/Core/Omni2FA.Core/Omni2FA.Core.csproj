<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Omni2FA.Core</PackageId>
    <Description>Omni2FA — framework-agnostic .NET backbone. Domain models, store interfaces, TOTP and Email OTP services. References no ASP.NET Core, no EF Core, no HTTP infrastructure. Consumed by Omni2FA.AspNetCore and any future non-ASP.NET adapter.</Description>
    <PackageTags>2fa;mfa;totp;otp;authenticator;security;framework-agnostic</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Otp.NET" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="8.0.10" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.2.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

</Project>
